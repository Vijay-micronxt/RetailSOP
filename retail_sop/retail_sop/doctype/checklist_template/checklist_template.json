 "fields": [
  {
   "fieldname": "template_name",
   "fieldtype": "Data",
   "in_list_view": 1,
   "label": "Template Name",
   "reqd": 1,
   "unique": 1
  },
  {
   "fieldname": "shift_type",
   "fieldtype": "Select",
   "in_list_view": 1,
   "label": "Shift Type",
   "options": "Pre-Opening\nMid-Day\nClosing\nWeekly Audit",
   "reqd": 1
  },
  {
   "default": "Outlet",
   "description": "Outlet: this template applies to one specific outlet (Location below). Food Court: it covers the whole food court at once - Location is left blank.",
   "fieldname": "checklist_scope",
   "fieldtype": "Select",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "label": "Checklist Scope",
   "options": "Outlet\nFood Court",
   "reqd": 1
  },
  {
   "depends_on": "eval:doc.checklist_scope == \"Outlet\"",
   "fieldname": "location",
   "fieldtype": "Link",
   "in_list_view": 1,
   "label": "Location",
   "options": "Outlet"
  },
  {
   "fieldname": "column_break_cadence",
   "fieldtype": "Column Break"
  },
  {
   "default": "Daily",
   "fieldname": "frequency",
   "fieldtype": "Select",
   "in_list_view": 1,
   "label": "Frequency",
   "options": "Daily\nWeekly",
   "reqd": 1
  },
  {
   "depends_on": "eval:doc.frequency == \"Weekly\"",
   "description": "Which day of the week a checklist gets auto-created from this template. Only used when Frequency is Weekly.",
   "fieldname": "weekly_day",
   "fieldtype": "Select",
   "label": "Weekly Day",
   "mandatory_depends_on": "eval:doc.frequency == \"Weekly\"",
   "options": "Monday\nTuesday\nWednesday\nThursday\nFriday\nSaturday\nSunday"
  },
  {
   "description": "Time of day by which a checklist created from this template must be submitted. Left blank = no cutoff, never marked Missed.",
   "fieldname": "cutoff_time",
   "fieldtype": "Time",
   "in_list_view": 1,
   "label": "Cutoff Time"
  },
  {
   "default": "1",
   "fieldname": "active",
   "fieldtype": "Check",
   "in_list_view": 1,
   "label": "Active"
  },
  {
   "fieldname": "items",
   "fieldtype": "Table",
   "label": "Checklist Items",
   "options": "Checklist Template Item"
  }
